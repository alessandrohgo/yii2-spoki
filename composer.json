{
    "name": "alessandrohgo/yii2-spoki",
    "description": "Estensione Yii2 per l'integrazione con Spoki (attivazione account WhatsApp Light, onboarding, iframe). Passo di pratica: valida la meccanica repository standalone -> test -> installazione via path repository in un'app Yii2 -> integrazione.",
    "type": "yii2-extension",
    "license": "proprietary",
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "^2.0",
        "yiisoft/yii2-queue": "^2.3",
        "php-curl-class/php-curl-class": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "AlessandroHgo\\Yii2Spoki\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlessandroHgo\\Yii2Spoki\\Tests\\": "tests/"
        }
    }
}
