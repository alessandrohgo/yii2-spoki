{
    "name": "alessandrohgo/yii2-spoki",
    "description": "Client API Spoki per Yii2 (SDK): tutte le chiamate API, gestione errori, e un modello/tabella generico per salvare gli account. Nessuna logica di business specifica di un progetto.",
    "type": "yii2-extension",
    "license": "proprietary",
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "^2.0",
        "php-curl-class/php-curl-class": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "AlessandroHgo\\Yii2Spoki\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlessandroHgo\\Yii2Spoki\\Tests\\": "tests/"
        }
    }
}
