{
    "name": "alessandrohgo/yii2-spoki",
    "description": "Client API Spoki per Yii2 (SDK) con job/servizi/controller di attivazione e iframe pronti all'uso, adattabili a qualunque progetto tramite 4 interfacce (acquisto, fatturazione, notifiche, storage account).",
    "type": "yii2-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "alessandrohgo"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "yiisoft/yii2": "^2.0",
        "yiisoft/yii2-queue": "^2.3",
        "php-curl-class/php-curl-class": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "AlessandroHgo\\Yii2Spoki\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlessandroHgo\\Yii2Spoki\\Tests\\": "tests/"
        }
    }
}
